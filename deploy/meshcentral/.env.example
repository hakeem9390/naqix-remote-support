# Copy to .env and fill in. .env is gitignored - never commit real values.

# Public FQDN. Must match the certificate nginx serves and be resolvable by
# customer machines, because agents pin the server to this name at install.
MESH_HOSTNAME=remote.naqix.example

PG_DATABASE=meshcentral
PG_USER=meshcentral
# openssl rand -base64 32
PG_PASSWORD=CHANGE_ME
